Output docs/media/menu.gif
Set Shell zsh
Set FontFamily "Menlo"
Set FontSize 14
Set Width 1640
Set Height 820
Set Padding 14
Set Margin 22
Set MarginFill "#11111b"
Set WindowBar Colorful
Set WindowBarSize 36
Set BorderRadius 12
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set Framerate 24
Env COLORTERM truecolor
Env GITPAD_LOGO text
Hide
Type 'cd "$GITPAD_DEMO" && clear && gitpad' Enter
Sleep 2.5s
Down@120ms 3
Show
Sleep 800ms
Enter
Sleep 1.2s
Screenshot docs/screenshots/menu.png
Down@250ms 6
Sleep 500ms
Type "r"
Sleep 1.2s
Escape
Sleep 300ms
Escape
Sleep 600ms
